<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    android:id="@+id/rootScroll"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tl_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">
            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/brand_mark"
                android:gravity="center"
                android:text="T"
                android:textColor="#071321"
                android:textSize="23sp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TraceLab"
                    android:textColor="@color/tl_text"
                    android:textSize="23sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.14"
                    android:text="LOCATION SECURITY DEMO"
                    android:textColor="@color/tl_muted"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/consent_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="7dp"
                android:text="CONSENT MODE"
                android:textColor="#9CE8D5"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create a transparent location demo"
            android:textColor="@color/tl_text"
            android:textSize="27sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:lineSpacingExtra="3dp"
            android:text="Select an image, create an expiring share link, and let the recipient decide whether to send a one-time location report."
            android:textColor="@color/tl_muted"
            android:textSize="13sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/tl_surface"
            app:cardCornerRadius="18dp"
            app:strokeColor="#293B55"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SERVER CONNECTION"
                    android:textColor="@color/tl_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="API base URL"
                    app:boxBackgroundColor="#091321"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="#52647F">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/apiBaseUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:singleLine="true"
                        android:text="" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Admin username"
                    app:boxBackgroundColor="#091321"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="#52647F">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/adminUsername"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:boxBackgroundColor="#091321"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="#52647F"
                    app:endIconMode="password_toggle"
                    android:hint="Admin password">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/adminPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Credentials are used only for authenticated link creation. They are not added to the recipient's URL."
                    android:textColor="@color/tl_muted"
                    android:textSize="10sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/tl_surface"
            app:cardCornerRadius="18dp"
            app:strokeColor="#293B55"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="01  ·  SELECT YOUR IMAGE"
                    android:textColor="@color/tl_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/selectImageButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Choose photograph from gallery"
                    android:textAllCaps="false"
                    app:icon="@android:drawable/ic_menu_gallery"
                    app:strokeColor="#607FA8" />
                <ImageView
                    android:id="@+id/imagePreview"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:layout_marginTop="12dp"
                    android:background="#091321"
                    android:contentDescription="Selected image preview"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="Demonstration title"
                    app:boxBackgroundColor="#091321"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="#52647F">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/sessionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences"
                        android:maxLength="100"
                        android:singleLine="true"
                        android:text="TraceLab location demo" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="LINK EXPIRY"
                    android:textColor="@color/tl_muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />
                <Spinner
                    android:id="@+id/expirySpinner"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:backgroundTint="#6C8AB2"
                    android:entries="@array/expiry_options"
                    android:spinnerMode="dropdown" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/createLinkButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:enabled="false"
                    android:text="Generate consent link"
                    android:textAllCaps="false"
                    app:backgroundTint="#78A7FF"
                    android:textColor="#071321" />
                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Choose an image to begin."
                    android:textColor="@color/tl_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/resultCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="#102C2A"
            app:cardCornerRadius="18dp"
            app:strokeColor="#397D6C"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✓  YOUR LINK IS READY"
                    android:textColor="#9CE8D5"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/expiryText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textColor="#B6CDBF"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/shareUrlText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="#071A19"
                    android:padding="12dp"
                    android:textColor="#D8F5E9"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/copyLinkButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Copy link"
                        android:textAllCaps="false" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/shareLinkButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="Share link"
                        android:textAllCaps="false"
                        app:backgroundTint="#5CD9D6"
                        android:textColor="#071321" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="No location permission is requested by this Android app. The recipient's browser asks for permission only after they read the notice, tick the consent box and tap Share my location."
            android:textColor="#7F91AD"
            android:textSize="10sp" />
    </LinearLayout>
</ScrollView>
