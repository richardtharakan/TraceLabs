# PostgreSQL. For local development, see docker-compose.yml.
DATABASE_URL=postgresql://tracelab:tracelab_dev_password@localhost:5432/tracelab

# Dashboard/API creator credentials. Use a long unique password outside local development.
ADMIN_USERNAME=tracelab-admin
ADMIN_PASSWORD=replace-this-with-a-long-random-password

# Public origin, without a trailing slash. Set this in production.
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000

# Optional in production on Vercel. If present, images are stored in Vercel Blob.
# For Vercel deployments, configure this rather than relying on ephemeral local disk.
BLOB_READ_WRITE_TOKEN=

# Optional: protect automated cleanup endpoint if enabled later.
CRON_SECRET=
